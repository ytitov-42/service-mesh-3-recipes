# Shared configuration — edit once, both roles use the same copy of this file.
# Everything here is a choice you make up front. Nothing is discovered.

# ---- identity of the cluster -------------------------------------------------
CLUSTER_NAME="rosa-xbxxb"             # ROSA cluster name (rosa CLI / tags / naming)
REGION="us-east-2"                    # AWS region of the cluster VPC

# ---- addressing --------------------------------------------------------------
# MUST NOT overlap the VPC CIDR, the cluster pod/service CIDRs, or anything on-prem.
# 01-cluster-prepare.sh and 02-aws-setup.sh both check this and refuse to continue.
CUDN_CIDR="192.168.100.0/24"          # Prefix advertised into the VPC (CUDN / demo VM subnet)

AMAZON_ASN="64512"                    # AWS Route Server ASN (BGP peer on the AWS side)
CLUSTER_ASN="65001"                   # OpenShift/FRR ASN — MUST differ from AMAZON_ASN

# ---- BGP behaviour -----------------------------------------------------------
LIVENESS_DETECTION="bfd"              # Session liveness: bfd | bgp-keepalive
ROUTER_NODE_LABEL_KEY="bgp_router"    # Node label key selecting BGP router workers
ROUTER_NODE_LABEL_VALUE="true"        # Node label value for those workers

# ---- names -------------------------------------------------------------------
OPERATOR_NS="openshift-bgp-cloud-connector"  # Namespace for the BGP Cloud Connector operator
OPERATOR_PKG="bgp-cloud-connector"           # OLM package name for the operator
OPERATOR_CHANNEL=""                          # OLM channel; empty = package default
DEMO_NAMESPACE="bgp-demo"                    # Namespace for demo CUDN / BGPRouting / VM
CUDN_NAME="prod"                             # CUDN name → cluster-udn-<name>; must match
                                             # the cluster-udn namespace label
BGPROUTING_NAME="cudn1"                      # BGPRouting CR name (advertises CUDN_CIDR)
VM_NAME="demo-vm"                            # KubeVirt VirtualMachine name in DEMO_NAMESPACE
CNV_NS="openshift-cnv"                       # OpenShift Virtualization namespace (03 installs if missing)
CNV_PKG="kubevirt-hyperconverged"            # OLM package for OpenShift Virtualization
CNV_CHANNEL=""                               # OLM channel; empty = package default (usually stable)
IAM_ROLE_NAME="bgp-cloud-connector-demo"     # IAM role for the operator (IRSA / STS)
RS_NAME_TAG="rosa-bgp-demo"                  # Name tag on the Route Server (also used to rediscover it)

# ---- optional test client ----------------------------------------------------
CREATE_TEST_CLIENT="false"            # Launch VPC EC2 client in 02; --with-test-client overrides
TEST_CLIENT_INSTANCE_TYPE="t3.micro"  # Instance type for the optional VPC test client
