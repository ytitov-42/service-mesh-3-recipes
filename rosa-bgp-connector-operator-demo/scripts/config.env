# Shared configuration — edit once, both roles use the same copy of this file.
# Everything here is a choice you make up front. Nothing is discovered.

# ---- identity of the cluster -------------------------------------------------
CLUSTER_NAME="rosa-rhp8w"             # ROSA cluster name (used by the rosa CLI if present)
REGION="us-east-2"                    # AWS region of the cluster

# ---- addressing --------------------------------------------------------------
# MUST NOT overlap the VPC CIDR, the cluster pod/service CIDRs, or anything on-prem.
# 01-cluster-prepare.sh and 02-aws-setup.sh both check this and refuse to continue.
CUDN_CIDR="192.168.100.0/24"

AMAZON_ASN="64512"                    # AWS side of the BGP session
CLUSTER_ASN="65001"                   # OpenShift side — MUST differ from AMAZON_ASN

# ---- BGP behaviour -----------------------------------------------------------
LIVENESS_DETECTION="bfd"              # bfd | bgp-keepalive
ROUTER_NODE_LABEL_KEY="bgp_router"
ROUTER_NODE_LABEL_VALUE="true"

# ---- names -------------------------------------------------------------------
OPERATOR_NS="openshift-bgp-cloud-connector"
OPERATOR_PKG="bgp-cloud-connector"
OPERATOR_CHANNEL=""                   # empty = use the package's default channel
DEMO_NAMESPACE="bgp-demo"
CUDN_NAME="prod"                      # becomes CUDN cluster-udn-<name>; must match the
                                      # cluster-udn namespace label
BGPROUTING_NAME="cudn1"
VM_NAME="demo-vm"
CNV_NS="openshift-cnv"                # OpenShift Virtualization (installed by 03 if missing)
CNV_PKG="kubevirt-hyperconverged"
CNV_CHANNEL=""                        # empty = package default (usually stable)
IAM_ROLE_NAME="bgp-cloud-connector-demo"
RS_NAME_TAG="rosa-bgp-demo"           # Name tag on the Route Server, also used to find it again

# ---- optional test client ----------------------------------------------------
CREATE_TEST_CLIENT="false"            # 02-aws-setup.sh --with-test-client overrides this
TEST_CLIENT_INSTANCE_TYPE="t3.micro"
